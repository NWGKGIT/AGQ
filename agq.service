[Unit]
Description=Antigravity Token Monitor — legacy headless daemon
After=network.target graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/agq-daemon
Restart=always
RestartSec=5
StandardOutput=append:%h/.agq/agq.log
StandardError=append:%h/.agq/agq.log
Environment=HOME=%h

[Install]
WantedBy=default.target
