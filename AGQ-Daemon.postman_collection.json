{
  "info": {
    "name": "AGQ Daemon API",
    "description": "Comprehensive test collection for the AGQ Daemon local HTTP API.\n\nThe daemon serves on `localhost:7432` by default. Override the `baseUrl` collection variable if you use a different port via `AGQ_PORT`.\n\n## Endpoints covered\n- `GET /api/health`\n- `GET /api/status`\n- `GET /api/accounts`\n- `GET /api/account/current`\n- `GET /api/accounts/{email}/latest`\n- `GET /api/accounts/{email}/snapshots`\n- `GET /api/models/latest`\n\n## Variables\n| Variable | Default | Purpose |\n|---|---|---|\n| `baseUrl` | `http://localhost:7432` | Daemon base URL |\n| `email` | `user@example.com` | Account email for parameterised requests |",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7432",
      "type": "string",
      "description": "Base URL of the AGQ Daemon. Change if you set AGQ_PORT."
    },
    {
      "key": "email",
      "value": "user@example.com",
      "type": "string",
      "description": "Account email used in per-account endpoint tests. Update to match a real account in your local DB."
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Tests for GET /api/health",
      "item": [
        {
          "name": "Health – 200 OK",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Daemon liveness probe. Should always return 200 with `status: \"ok\"` and a human-readable `uptime` string."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Content-Type is JSON', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "pm.test('Body has status: ok', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql('ok');",
                  "});",
                  "",
                  "pm.test('Body has non-empty uptime string', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.uptime).to.be.a('string').and.to.have.length.above(0);",
                  "});",
                  "",
                  "pm.test('No unexpected extra keys', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(Object.keys(body).sort()).to.eql(['status', 'uptime'].sort());",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Health – CORS preflight (OPTIONS)",
          "request": {
            "method": "OPTIONS",
            "header": [
              { "key": "Origin", "value": "http://localhost:3000" },
              { "key": "Access-Control-Request-Method", "value": "GET" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "CORS preflight must be answered with 204 and correct Access-Control headers for localhost origins."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204 No Content', () => pm.response.to.have.status(204));",
                  "",
                  "pm.test('Access-Control-Allow-Origin echoes the localhost origin', () => {",
                  "    pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql('http://localhost:3000');",
                  "});",
                  "",
                  "pm.test('Access-Control-Allow-Methods includes GET', () => {",
                  "    const methods = pm.response.headers.get('Access-Control-Allow-Methods') || '';",
                  "    pm.expect(methods).to.include('GET');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Health – CORS blocked for non-localhost origin",
          "request": {
            "method": "OPTIONS",
            "header": [
              { "key": "Origin", "value": "https://evil.example.com" },
              { "key": "Access-Control-Request-Method", "value": "GET" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "The CORS middleware must NOT set Access-Control-Allow-Origin for non-localhost origins."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('No Access-Control-Allow-Origin header for external origin', () => {",
                  "    const header = pm.response.headers.get('Access-Control-Allow-Origin');",
                  "    pm.expect(header).to.be.oneOf([null, undefined, '']);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Status",
      "description": "Tests for GET /api/status",
      "item": [
        {
          "name": "Status – 200 OK (shape)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "status"]
            },
            "description": "Returns the full DaemonStatus object. State must be either ACTIVE or IDLE."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Content-Type is JSON', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('state is ACTIVE or IDLE', () => {",
                  "    pm.expect(body.state).to.be.oneOf(['ACTIVE', 'IDLE']);",
                  "});",
                  "",
                  "pm.test('uptime is a non-empty string', () => {",
                  "    pm.expect(body.uptime).to.be.a('string').and.have.length.above(0);",
                  "});",
                  "",
                  "pm.test('started_at is an ISO-8601 timestamp', () => {",
                  "    pm.expect(body.started_at).to.be.a('string');",
                  "    pm.expect(new Date(body.started_at).toString()).to.not.eql('Invalid Date');",
                  "});",
                  "",
                  "pm.test('When ACTIVE, emails array is present and non-empty', () => {",
                  "    if (body.state === 'ACTIVE') {",
                  "        pm.expect(body.emails).to.be.an('array').and.have.length.above(0);",
                  "    }",
                  "});",
                  "",
                  "pm.test('Optional timestamp fields are valid when present', () => {",
                  "    for (const field of ['last_poll_at', 'next_poll_at']) {",
                  "        if (body[field] !== undefined && body[field] !== null) {",
                  "            pm.expect(new Date(body[field]).toString()).to.not.eql('Invalid Date',",
                  "                field + ' must be a valid timestamp');",
                  "        }",
                  "    }",
                  "});",
                  "",
                  "// Persist state for downstream tests",
                  "pm.collectionVariables.set('daemonState', body.state);",
                  "if (body.emails && body.emails.length > 0) {",
                  "    pm.collectionVariables.set('email', body.emails[0]);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Accounts",
      "description": "Tests for GET /api/accounts",
      "item": [
        {
          "name": "Accounts – 200 OK (shape)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts"]
            },
            "description": "Returns all known accounts. The `accounts` array may be empty if no accounts have been seen yet."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Content-Type is JSON', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Body has accounts array', () => {",
                  "    pm.expect(body.accounts).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Each account has required fields', () => {",
                  "    body.accounts.forEach((a, i) => {",
                  "        pm.expect(a.id, `accounts[${i}].id`).to.be.a('number');",
                  "        pm.expect(a.email, `accounts[${i}].email`).to.be.a('string').and.match(/.+@.+/);",
                  "        pm.expect(a.plan_name, `accounts[${i}].plan_name`).to.be.a('string');",
                  "        pm.expect(a.first_seen, `accounts[${i}].first_seen`).to.be.a('string');",
                  "        pm.expect(new Date(a.first_seen).toString()).to.not.eql('Invalid Date');",
                  "        pm.expect(a.last_seen, `accounts[${i}].last_seen`).to.be.a('string');",
                  "        pm.expect(new Date(a.last_seen).toString()).to.not.eql('Invalid Date');",
                  "    });",
                  "});",
                  "",
                  "pm.test('latest_snapshot shape is correct when present', () => {",
                  "    body.accounts.forEach((a, i) => {",
                  "        if (a.latest_snapshot) {",
                  "            const s = a.latest_snapshot;",
                  "            pm.expect(s.email, `accounts[${i}].latest_snapshot.email`).to.be.a('string');",
                  "            pm.expect(s.plan_name, `accounts[${i}].latest_snapshot.plan_name`).to.be.a('string');",
                  "            pm.expect(s.captured_at, `accounts[${i}].latest_snapshot.captured_at`).to.be.a('string');",
                  "            pm.expect(s.staleness_seconds, `accounts[${i}].latest_snapshot.staleness_seconds`).to.be.a('number').and.to.be.at.least(0);",
                  "            pm.expect(s.prompt_credits_available).to.be.a('number');",
                  "            pm.expect(s.prompt_credits_monthly).to.be.a('number');",
                  "            pm.expect(s.flow_credits_available).to.be.a('number');",
                  "            pm.expect(s.flow_credits_monthly).to.be.a('number');",
                  "            pm.expect(s.models).to.be.an('array');",
                  "        }",
                  "    });",
                  "});",
                  "",
                  "// Capture first email for later use if not already set",
                  "if (!pm.collectionVariables.get('email') && body.accounts.length > 0) {",
                  "    pm.collectionVariables.set('email', body.accounts[0].email);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Accounts – CORS allowed with 127.0.0.1 origin",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Origin", "value": "http://127.0.0.1:5173" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts"]
            },
            "description": "127.0.0.1 is also an allowed CORS origin per the daemon policy."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Access-Control-Allow-Origin echoes 127.0.0.1 origin', () => {",
                  "    pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql('http://127.0.0.1:5173');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Current Account",
      "description": "Tests for GET /api/account/current",
      "item": [
        {
          "name": "Current Account – 200 OK (shape)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/account/current",
              "host": ["{{baseUrl}}"],
              "path": ["api", "account", "current"]
            },
            "description": "Returns live daemon state joined with the latest snapshot for each active account. `state` is ACTIVE or IDLE. When IDLE, `accounts` is empty and `email`/`account` are absent."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Content-Type is JSON', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('state is ACTIVE or IDLE', () => {",
                  "    pm.expect(body.state).to.be.oneOf(['ACTIVE', 'IDLE']);",
                  "});",
                  "",
                  "pm.test('accounts is always an array', () => {",
                  "    pm.expect(body.accounts).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('as_of is a valid timestamp', () => {",
                  "    pm.expect(body.as_of).to.be.a('string');",
                  "    pm.expect(new Date(body.as_of).toString()).to.not.eql('Invalid Date');",
                  "});",
                  "",
                  "if (body.state === 'ACTIVE') {",
                  "    pm.test('[ACTIVE] email is present and non-empty', () => {",
                  "        pm.expect(body.email).to.be.a('string').and.have.length.above(0);",
                  "    });",
                  "",
                  "    pm.test('[ACTIVE] account object is present', () => {",
                  "        pm.expect(body.account).to.be.an('object');",
                  "    });",
                  "",
                  "    pm.test('[ACTIVE] accounts array is non-empty', () => {",
                  "        pm.expect(body.accounts).to.have.length.above(0);",
                  "    });",
                  "",
                  "    pm.test('[ACTIVE] account.email matches top-level email', () => {",
                  "        pm.expect(body.account.email).to.eql(body.email);",
                  "    });",
                  "",
                  "    pm.test('[ACTIVE] last_poll_at is valid when present', () => {",
                  "        if (body.last_poll_at) {",
                  "            pm.expect(new Date(body.last_poll_at).toString()).to.not.eql('Invalid Date');",
                  "        }",
                  "    });",
                  "} else {",
                  "    pm.test('[IDLE] email field is absent or empty', () => {",
                  "        pm.expect(body.email || '').to.eql('');",
                  "    });",
                  "",
                  "    pm.test('[IDLE] account field is absent', () => {",
                  "        pm.expect(body.account).to.be.undefined;",
                  "    });",
                  "",
                  "    pm.test('[IDLE] accounts array is empty', () => {",
                  "        pm.expect(body.accounts).to.eql([]);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Account – Latest Snapshot",
      "description": "Tests for GET /api/accounts/{email}/latest",
      "item": [
        {
          "name": "Account Latest – 200 OK (known email)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{email}}/latest",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts", "{{email}}", "latest"]
            },
            "description": "Returns the newest QuotaSnapshot for `{{email}}`. Requires at least one snapshot to exist for that account."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Content-Type is JSON', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('email field is present', () => {",
                  "    pm.expect(body.email).to.be.a('string').and.have.length.above(0);",
                  "});",
                  "",
