    {
      "name": "Models – Latest Quotas",
      "description": "Tests for GET /api/models/latest",
      "item": [
        {
          "name": "Models Latest – 200 OK (shape)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/models/latest",
              "host": ["{{baseUrl}}"],
              "path": ["api", "models", "latest"]
            },
            "description": "Returns the latest ModelQuotaAggregate rows from the newest snapshot of each known account."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Content-Type is JSON', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Body has models array', () => {",
                  "    pm.expect(body.models).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Each model has required scalar fields', () => {",
                  "    body.models.forEach((m, i) => {",
                  "        pm.expect(m.label, `models[${i}].label`).to.be.a('string');",
                  "        pm.expect(m.model_id, `models[${i}].model_id`).to.be.a('string');",
                  "        pm.expect(m.is_exhausted, `models[${i}].is_exhausted`).to.be.a('boolean');",
                  "        pm.expect(m.email, `models[${i}].email`).to.be.a('string').and.match(/.+@.+/);",
                  "        pm.expect(m.captured_at, `models[${i}].captured_at`).to.be.a('string');",
                  "        pm.expect(new Date(m.captured_at).toString()).to.not.eql('Invalid Date',",
                  "            `models[${i}].captured_at must be a valid timestamp`);",
                  "        pm.expect(m.staleness_seconds, `models[${i}].staleness_seconds`)",
                  "            .to.be.a('number').and.to.be.at.least(0);",
                  "    });",
                  "});",
                  "",
                  "pm.test('remaining_fraction and remaining_pct are fractions when present', () => {",
                  "    body.models.forEach((m, i) => {",
                  "        if (m.remaining_fraction !== null && m.remaining_fraction !== undefined) {",
                  "            pm.expect(m.remaining_fraction, `models[${i}].remaining_fraction`).to.be.within(0, 1);",
                  "        }",
                  "        if (m.remaining_pct !== null && m.remaining_pct !== undefined) {",
                  "            pm.expect(m.remaining_pct, `models[${i}].remaining_pct`).to.be.within(0, 100);",
                  "        }",
                  "    });",
                  "});",
                  "",
                  "pm.test('Optional reset_time fields are valid timestamps when present', () => {",
                  "    body.models.forEach((m, i) => {",
                  "        for (const field of ['reset_time', 'pool_reset_time']) {",
                  "            if (m[field] !== null && m[field] !== undefined) {",
                  "                pm.expect(new Date(m[field]).toString(), `models[${i}].${field}`)",
                  "                    .to.not.eql('Invalid Date');",
                  "            }",
                  "        }",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
