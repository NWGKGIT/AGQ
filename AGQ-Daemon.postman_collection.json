                  "pm.test('flow credit fields are numbers', () => {",
                  "    pm.expect(body.flow_credits_available).to.be.a('number');",
                  "    pm.expect(body.flow_credits_monthly).to.be.a('number');",
                  "});",
                  "",
                  "pm.test('models is an array', () => {",
                  "    pm.expect(body.models).to.be.an('array');",
                  "});",
