    {
      "name": "Account – Snapshot History",
      "description": "Tests for GET /api/accounts/{email}/snapshots",
      "item": [
        {
          "name": "Snapshots – 200 OK (defaults)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{email}}/snapshots",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts", "{{email}}", "snapshots"],
              "query": []
            },
            "description": "Returns snapshot history newest-first with a default limit of 50. The `snapshots` array may be empty if no data has been captured yet."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Content-Type is JSON', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Body has email and snapshots fields', () => {",
                  "    pm.expect(body.email).to.be.a('string');",
                  "    pm.expect(body.snapshots).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('snapshots count is at most 50 (default limit)', () => {",
                  "    pm.expect(body.snapshots.length).to.be.at.most(50);",
                  "});",
                  "",
                  "pm.test('Snapshots are in descending captured_at order', () => {",
                  "    const snaps = body.snapshots;",
                  "    for (let i = 1; i < snaps.length; i++) {",
                  "        const prev = new Date(snaps[i-1].captured_at).getTime();",
                  "        const curr = new Date(snaps[i].captured_at).getTime();",
                  "        pm.expect(prev).to.be.at.least(curr,",
                  "            `snapshots[${i-1}].captured_at should be >= snapshots[${i}].captured_at`);",
                  "    }",
                  "});",
                  "",
                  "// Save captured_at of last snapshot to use in 'before' test",
                  "if (body.snapshots.length > 0) {",
                  "    const last = body.snapshots[body.snapshots.length - 1];",
                  "    pm.collectionVariables.set('beforeTimestamp', last.captured_at);",
                  "}"
                ]
              }
            }
          ]
        },
