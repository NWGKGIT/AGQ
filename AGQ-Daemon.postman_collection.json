        {
          "name": "Snapshots – Max limit=200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{email}}/snapshots?limit=200",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts", "{{email}}", "snapshots"],
              "query": [
                { "key": "limit", "value": "200", "description": "Maximum allowed limit" }
              ]
            },
            "description": "Limit 200 is the store maximum; values above it are clamped to 200 by the store."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
